pipeline {
    agent any // Tối ưu: Dùng môi trường gốc để tránh lỗi "Invalid agent type docker"

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE = "ngchicuong8820/lab1-app"
        IMAGE_TAG = "v${env.BUILD_NUMBER}"
        GITOPS_REPO = "https://github.com/ngchicuong8820/Lab_1.git"
        APP_URL = "http://host.docker.internal:8080"
        
        DOCKER_CRED_ID = 'docker-creds'
        GITHUB_CRED_ID = 'github-token'
    }

    stages {
        stage('1. Checkout Code') {
            steps { checkout scm }
        }

        stage('2. Code & IaC Security (SAST/SCA)') {
            failFast true
            parallel {
                stage('Unit Test') {
                    steps { 
                        dir('app-repo') { sh 'mvn clean test' }
                    }
                }
                stage('SAST & SCA (Trivy)') {
                    steps {
                        // Tối ưu: Cài Trivy vào thư mục ./bin cục bộ để tránh lỗi thiếu quyền Root
                        sh '''
                        curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b ./bin
                        ./bin/trivy fs ./app-repo/ --scanners vuln,secret,misconfig --exit-code 0
                        '''
                    }
                }
                stage('IaC Scan') {
                    steps {
                        sh './bin/trivy config ./gitops-repo/ --exit-code 0 --severity HIGH,CRITICAL'
                    }
                }
            }
        }

        stage('3. Build Artifact') {
            steps { 
                dir('app-repo') { sh 'mvn clean package -DskipTests' } 
            }
        }

        stage('4. Build Image') {
            steps { sh "docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} ./app-repo" }
        }

        stage('5. Container Security') {
            steps {
                sh "./bin/trivy image --exit-code 0 --severity HIGH,CRITICAL ${DOCKER_IMAGE}:${IMAGE_TAG}"
            }
        }

        stage('6. Push Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.DOCKER_CRED_ID, passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                    sh """
                    echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('7. Update GitOps Manifest') {
            steps {
                withCredentials([string(credentialsId: env.GITHUB_CRED_ID, variable: 'GIT_TOKEN')]) {
                    sh """
                    # Tối ưu: Dọn dẹp thư mục clone cũ để tránh rác từ các lần build trước
                    rm -rf lab1-temp
                    
                    git clone https://oauth2:\${GIT_TOKEN}@github.com/ngchicuong8820/Lab_1.git lab1-temp
                    cd lab1-temp

                    sed -i "s|image: ${DOCKER_IMAGE}:.*|image: ${DOCKER_IMAGE}:${IMAGE_TAG}|g" gitops-repo/deployment.yaml

                    git config user.name "Jenkins DevSecOps Bot"
                    git config user.email "jenkins@lab.local"
                    git add gitops-repo/
                    git commit -m "chore: release ${IMAGE_TAG} [skip ci]"
                    git push origin HEAD:main
                    """
                }
            }
        }

        stage('8. Dynamic Application Security Testing (DAST)') {
            steps {
                sh """
                echo "Quét DAST vào ứng dụng frontend..."
                docker run --rm -t owasp/zap2docker-stable zap-baseline.py -t ${APP_URL} -I || true
                """
            }
        }
    }
    
    post {
        always {
            // Tối ưu: Dùng shell script để dọn dẹp workspace thay cho plugin Workspace Cleanup
            sh 'rm -rf ./*'
        }
    }
}